{
  "name": "y-editor",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sidecars": "node scripts/fetch-sidecars.mjs",
    "test:ai": "node --test scripts/test-pi.mjs",
    "package:portable": "node scripts/package-portable.mjs",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"resources/**/*.mjs\"",
    "ui:check": "node scripts/ui-check.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@milkdown/kit": "7.22.1",
    "@phosphor-icons/vue": "^2.2.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "2.11.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror-lang-mermaid": "0.5.0",
    "diff": "8.0.2",
    "docx": "^9.7.1",
    "dompurify": "3.4.15",
    "katex": "0.18.7",
    "markdown-it": "^15.0.2",
    "mermaid": "11.12.0",
    "pinia": "3.0.4",
    "pinyin-pro": "3.29.4",
    "reka-ui": "2.10.4",
    "remark-frontmatter": "5.0.0",
    "remark-math": "6.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "2.11.4",
    "@types/diff": "7.0.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "22.20.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.11.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "3.2.4",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
